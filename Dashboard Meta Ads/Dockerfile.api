FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-requests ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY ["Dashboard Meta Ads/", "/app/Dashboard Meta Ads/"]
COPY ["Meta Ads Monitor/", "/app/monitor/"]
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8091
ENV META_MONITOR_DIR=/app/monitor
WORKDIR /app/Dashboard Meta Ads
CMD ["node", "preview-server.js"]
